{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feature-flag-api",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "upload_source_maps": true,
  "compatibility_date": "2026-08-05",
  "compatibility_flags": [
		"nodejs_compat"
	],
  "d1_databases": [
    {
      "binding": "feature_flag_db",
      "database_name": "feature-flag-db",
      "database_id": "ef45ef64-dc2d-4c81-adf5-16651dfb0a2e",
      "remote": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "feature_flag_kv",
      "id": "0bb0ade61a3147c8b0b9c27add977db8",
      "remote": true
    }
  ]
}